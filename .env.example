# Local development only. These are placeholders for the devcontainer's Postgres
# and are not secrets. Copy to .env to override them. Never put real credentials
# in this file or in .env.

# Dev container Postgres superuser. Used ONLY by db/bootstrap to create the
# databases and roles — no application ever connects as it (CONTRACT.md).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_dev_only
POSTGRES_HOST=db

# Owner-role passwords (Rails). db/bootstrap creates admin_dev / admin_test with
# these, and Rails connects with them (config/database.yml). Placeholders only.
ADMIN_DEV_PASSWORD=admin_dev_local_dev
ADMIN_TEST_PASSWORD=admin_test_local_dev

# Reader-role passwords (Phoenix). db/bootstrap creates reader_dev / reader_test
# with these; the board connects with them. Placeholders only.
READER_DEV_PASSWORD=reader_dev_local_dev
READER_TEST_PASSWORD=reader_test_local_dev

# HTTP basic auth for the Rails admin. Local placeholders only; production sets these
# as Render env vars.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Sanity (public listing content). Leave unset locally: with no project configured the
# listing page renders fallback copy from the property record and makes no network call.
# Set these in production (Render env vars) once a Sanity project exists.
# SANITY_PROJECT_ID=your_project_id
# SANITY_DATASET=production
# SANITY_API_VERSION=2024-01-01

# Local development only. These are placeholders for the devcontainer's Postgres
# and are not secrets. Copy to .env to override them. Never put real credentials
# in this file or in .env.
POSTGRES_USER=leaseboard
POSTGRES_PASSWORD=local_dev_only
DATABASE_URL=postgres://leaseboard:local_dev_only@db:5432

# Password for the read-only board_reader role the Rails migration creates and the
# Phoenix board connects with. Local placeholder only — never a real credential.
BOARD_READER_PASSWORD=board_reader_local_dev

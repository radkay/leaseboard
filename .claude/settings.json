{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git rebase * main)",
      "Bash(git rebase * dev)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm -r *)",
      "Bash(gh repo edit *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh pr merge *--admin*)",
      "Bash(render *)",
      "Bash(npx render*)",
      "Bash(sanity *)",
      "Bash(npx sanity*)",
      "Bash(npx @sanity/cli*)",
      "Bash(npm exec sanity*)",
      "Bash(npm exec -- sanity*)",

      "PowerShell(git push *--force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push *+*)",
      "PowerShell(git push --all*)",
      "PowerShell(git push * --all*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git push * -d *)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase * main)",
      "PowerShell(git rebase * dev)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git filter-repo *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(rm *-r*)",
      "PowerShell(ri *)",
      "PowerShell(del *-r*)",
      "PowerShell(rmdir *)",
      "PowerShell(rd *)",
      "PowerShell(cmd /c rmdir *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh api *)",
      "PowerShell(gh secret *)",
      "PowerShell(gh variable *)",
      "PowerShell(gh ruleset *)",
      "PowerShell(gh pr merge *--admin*)",
      "PowerShell(render *)",
      "PowerShell(npx render*)",
      "PowerShell(sanity *)",
      "PowerShell(npx sanity*)",
      "PowerShell(npx @sanity/cli*)",
      "PowerShell(npm exec sanity*)",
      "PowerShell(npm exec -- sanity*)",

      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(**/config/master.key)",
      "Read(**/config/credentials/*.key)",
      "Edit(**/config/master.key)",
      "Edit(**/config/credentials/*.key)",
      "Edit(.claude/**)"
    ]
  }
}

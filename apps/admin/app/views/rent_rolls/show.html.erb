<h1>Rent roll</h1>

<%= form_with url: rent_roll_path, method: :get, class: "rent-roll-filter" do |form| %>
  <div><%= form.label :property_id, "Property" %>
  <%= form.collection_select :property_id, @properties, :id, :name, selected: @property&.id %></div>
  <div><%= form.label :as_of, "As of" %>
  <%= form.date_field :as_of, value: @as_of %></div>
  <%= form.submit "Show" %>
<% end %>

<% if @rent_roll %>
  <p>
    <strong><%= @property.name %></strong> as of <%= @as_of %> ·
    <%= link_to "Download CSV", rent_roll_path(property_id: @property.id, as_of: @as_of, format: :csv) %>
  </p>

  <table>
    <thead>
      <tr>
        <th>Unit</th><th class="num">Bedrooms</th><th>Status</th><th>Resident</th>
        <th class="num">Monthly rent</th><th class="num">Market rent</th><th>Lease end</th>
      </tr>
    </thead>
    <tbody>
      <% @rent_roll.rows.each do |row| %>
        <tr>
          <td><%= link_to row.unit_number, unit_path(row.unit_id) %></td>
          <td class="num"><%= row.bedrooms.zero? ? "Studio" : row.bedrooms %></td>
          <td><%= status_pill(row.status) %></td>
          <td><%= row.lease_id ? link_to(row.resident_name, lease_path(row.lease_id)) : "—" %></td>
          <td class="num"><%= number_to_currency(row.monthly_rent) if row.monthly_rent %></td>
          <td class="num"><%= number_to_currency(row.market_rent) %></td>
          <td><%= row.lease_end_date %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="7">
          <strong>Units:</strong> <%= @rent_roll.total_units %> ·
          <strong>Occupied:</strong> <%= @rent_roll.occupied_units %> ·
          <strong>Occupancy:</strong> <%= @rent_roll.occupancy_pct %>% ·
          <strong>Scheduled rent:</strong> <%= number_to_currency(@rent_roll.scheduled_rent) %>
        </td>
      </tr>
    </tfoot>
  </table>
<% end %>

<p><%= link_to "Back to properties", properties_path %></p>

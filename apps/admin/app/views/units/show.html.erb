<% content_for :title, "Unit #{@unit.number}" %>

<% if notice %><p class="flash"><%= notice %></p><% end %>
<% if alert %><p class="flash alert"><%= alert %></p><% end %>

<div data-controller="new-lease" data-action="turbo:submit-end->new-lease#submitEnd">
  <div class="actions">
    <button type="button" data-action="new-lease#open">Add new lease</button>
  </div>

  <dialog class="panel" data-new-lease-target="dialog">
    <button type="button" class="panel-close" data-action="new-lease#close" aria-label="Close">&times;</button>
    <h3>Sign a new lease</h3>
    <%= render "units/new_lease_form", unit: @unit, errors: nil %>
  </dialog>
</div>

<%= render @unit %>

<h2>Leases</h2>

<table>
  <thead>
    <tr>
      <th>Status</th><th>Resident</th><th class="num">Rent</th><th>Lease start</th><th>Lease end</th>
    </tr>
  </thead>
  <tbody id="unit_leases">
    <% @leases.each do |lease| %>
      <%= render "leases/lease_row", lease: lease %>
    <% end %>
  </tbody>
</table>

<div class="actions">
  <%= link_to "Edit this unit", edit_unit_path(@unit) %>
  <%= link_to "Back to #{@unit.property.name}", @unit.property %>
</div>

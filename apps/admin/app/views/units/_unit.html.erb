<div id="<%= dom_id unit %>">
  <div>
    <strong>Property:</strong>
    <%= unit.property.name %>
  </div>

  <div>
    <strong>Number:</strong>
    <%= unit.number %>
  </div>

  <div>
    <strong>Bedrooms:</strong>
    <%= unit.bedrooms %>
  </div>

  <div>
    <strong>Bathrooms:</strong>
    <%= unit.bathrooms %>
  </div>

  <div>
    <strong>Sq ft:</strong>
    <%= unit.sq_ft %>
  </div>

  <div>
    <strong>Market rent:</strong>
    <%= money(unit.market_rent) %>
  </div>

</div>

<div id="<%= dom_id property %>">
  <div>
    <strong>Name:</strong>
    <%= property.name %>
  </div>

  <div>
    <strong>Address:</strong>
    <%= property.address %>
  </div>

  <div>
    <strong>City:</strong>
    <%= property.city %>
  </div>

  <div>
    <strong>State:</strong>
    <%= property.state %>
  </div>

  <div>
    <strong>Sanity slug:</strong>
    <%= property.sanity_slug %>
  </div>

</div>
